# Local development template. Copy to .env.local and use test credentials only.
# Never commit real credentials, tokens, or access codes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_ID=
AUTH_SECRET=
BLOB_READ_WRITE_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
# Vercel Preview uses ONLY these dedicated isolated test settings. No fallback
# to inherited production keys; equal generic/Preview values are rejected.
# Leave blank to disable private Preview access. Create/use separate test
# resources only with owner authorization. Never use shared production storage.
PREVIEW_AUTH_SECRET=
PREVIEW_KV_REST_API_URL=
PREVIEW_KV_REST_API_TOKEN=
PREVIEW_BLOB_READ_WRITE_TOKEN=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
RESEND_API_KEY=
STRIPE_PRO_PRODUCT_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# New NZ purchases only. Existing subscriptions and international prices unchanged.
STRIPE_PRO_NZ_MONTHLY_PRICE_ID=
# No NZ annual price has been selected. Leave these blank/false until approved.
STRIPE_PRO_NZ_ANNUAL_PRICE_ID=
STRIPE_PRO_NZ_ANNUAL_AMOUNT=
STRIPE_PRO_NZ_ANNUAL_APPROVED=false

# New access foundations remain closed until policy, funding and signed-in QA
# approvals are recorded. Preview always disables actual new invites/grants.
DOCTORAI_CARE_SHARING_ENABLED=false
DOCTORAI_ADULT_SHARING_POLICY_APPROVED=false
DOCTORAI_CARE_SIGNED_IN_QA_APPROVED=false
DOCTORAI_SUPPORT_INTAKE_ENABLED=false
DOCTORAI_SUPPORT_FUNDED_PLACES=0
DOCTORAI_SUPPORT_APPLICATION_RETENTION_DAYS=
DOCTORAI_SUPPORT_AI_REQUESTS_PER_MONTH=
DOCTORAI_SUPPORT_SCANS_PER_MONTH=
DOCTORAI_SUPPORT_STORED_BYTES=
DOCTORAI_SUPPORT_REVIEW_MINUTES=
DOCTORAI_SUPPORT_POLICY_VERSION=
DOCTORAI_SUPPORT_ELIGIBILITY_APPROVED=false
DOCTORAI_SUPPORT_REVIEW_CHANNEL_APPROVED=false
DOCTORAI_SUPPORT_SIGNED_IN_QA_APPROVED=false
# Future cash reporting: no invented year, accounting basis, recipient or total.
DOCTORAI_CONTRIBUTION_ENABLED=false
DOCTORAI_CONTRIBUTION_ACCOUNTING_APPROVED=false
DOCTORAI_CONTRIBUTION_FINANCIAL_YEAR=
DOCTORAI_CONTRIBUTION_PROFIT_DEFINITION_REF=
DOCTORAI_CONTRIBUTION_PAYOUT_TIMING_REF=
DOCTORAI_CONTRIBUTION_RECIPIENT_REF=
DOCTORAI_CONTRIBUTION_CURRENCY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCTORAI_FREE_PRO_CODE=

# Do not enable medication safety requests without a signed licence that explicitly
# permits this consumer-facing safety-critical use and approved clinical modules.
# Confirm in writing that the DrugBank ingredient-level scope is suitable for NZ use.
DRUGBANK_API_KEY=
DRUGBANK_COMMERCIAL_LICENSED=false
DRUGBANK_SAFETY_CRITICAL_USE_APPROVED=false
DRUGBANK_NZ_INGREDIENT_SCOPE_APPROVED=false
DRUGBANK_CLINICAL_MODULES=

# NZF/NZULM product-search and interaction prototype; do not enable until signed consumer-use licensing is approved.
# Obtain the base URL, allowed host and OAuth details from NZF during onboarding.
# This prototype accepts only a server-side short-lived bearer token with an explicit expiry;
# it does not yet implement an OAuth refresh flow and must not be used in production.
NZF_FHIR_BASE_URL=
NZF_FHIR_ALLOWED_HOSTS=
NZF_FHIR_ACCESS_TOKEN=
NZF_FHIR_ACCESS_TOKEN_EXPIRES_AT=
NZF_NZMT_SEARCH_CONSUMER_USE_APPROVED=false
# Interactions stay disabled until the vendor approves safety-critical consumer use and detail display.
NZF_INTERACTION_CONSUMER_USE_APPROVED=false
NZF_INTERACTION_DISPLAY_APPROVED=false
