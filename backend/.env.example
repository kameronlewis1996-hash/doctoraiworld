# Copy this file to .env and fill in real values before running the server.

PORT=4000

# Long random string used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long an admin login session stays valid.
JWT_EXPIRES_IN=12h

# Path to the SQLite database file.
DB_PATH=./data/admin.db

# Seed admin account, created the first time `npm run seed` is executed.
# Change the password immediately after first login in a real deployment.
SEED_ADMIN_EMAIL=admin@doctoraiworld.com
SEED_ADMIN_PASSWORD=change-me-now
